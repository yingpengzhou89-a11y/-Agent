APP_ENV=development
APP_NAME=Interview Copilot Agent
APP_SECRET_KEY=change-me-before-production
DATABASE_URL=postgresql+asyncpg://interview:interview@localhost:5432/interview_copilot

CHAT_BASE_URL=
CHAT_API_KEY=
CHAT_MODEL=
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2

# Any OpenAI-compatible Embeddings provider. Do not use a chat-only endpoint.
# Example base URL: https://<provider>/v1
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
MAX_UPLOAD_MB=20
STORAGE_DIR=data/uploads
